{
  "name": "android-tv-remote-desktop",
  "version": "0.2.0",
  "description": "Relay — a wireless-first Android TV remote for macOS and Windows, powered by ADB.",
  "author": "Satyam Kashyap",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepare:scrcpy": "node scripts/prepare-scrcpy.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && npm run prepare:scrcpy && electron-builder",
    "release:build": "npm run build && npm run prepare:scrcpy && electron-builder --publish never",
    "release:build:mac": "npm run build && npm run prepare:scrcpy && electron-builder --mac dmg zip --publish never",
    "release:build:win": "npm run build && npm run prepare:scrcpy && electron-builder --win nsis zip --publish never",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.satyamkashyap.androidtvremote",
    "productName": "Relay",
    "copyright": "Copyright © 2026 Satyam Kashyap",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/scrcpy",
        "to": "scrcpy",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "identity": null,
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Relay",
      "uninstallDisplayName": "${productName} ${version}"
    }
  },
  "dependencies": {
    "androidtv-remote": "^1.0.10",
    "bonjour-service": "^1.3.0",
    "electron-store": "^10.0.1",
    "node-apk": "^1.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.4"
  }
}
