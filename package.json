{
  "name": "android-tv-remote-desktop",
  "version": "0.1.0",
  "description": "Wireless-first Android TV remote desktop app powered by ADB.",
  "author": "Satyam Kashyap",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.satyamkashyap.androidtvremote",
    "productName": "Android TV Remote",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "androidtv-remote": "^1.0.10",
    "bonjour-service": "^1.3.0",
    "electron-store": "^10.0.1",
    "node-apk": "^1.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.4"
  }
}
